EDITS/*-unsplash.jpg

# Konfigurasi lokal Claude Code
.claude/

# Skill agent lokal (impeccable, ui-ux-pro-max, marketingskills, dll)
.agents/

# Berkas sistem
Thumbs.db
desktop.ini
.DS_Store

# Dependency untuk fungsi /api (lihat package.json) -- Vercel yang
# meng-install ulang ini sendiri tiap deploy, tidak perlu ikut ke Git.
# .env.local juga tidak boleh ke-commit kalau nanti dipakai buat coba
# env var secara lokal (isinya bisa berupa token asli).
node_modules/
.env.local

# Secret Apps Script (nilai SECRET di apps-script.gs, sama dengan
# APPS_SCRIPT_SECRET di Vercel). Kalau ini bocor, siapa pun bisa menulis
# baris ke spreadsheet pendaftaran, menyimpan berkas ke Drive, dan
# mengirim email dari akun Gmail pemilik sheet. Berkasnya tetap ada di
# komputer, cuma tidak pernah ikut ter-push.
PW APPSRIPT.txt
